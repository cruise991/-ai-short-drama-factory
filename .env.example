# ==============================================================================
# AI Short Drama Factory - Global Environment Configuration Template
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# 严禁将包含真实密钥的 .env 提交至 GitHub 仓库！
# ==============================================================================

# --- Global & Orchestration Settings ---
MAX_SHOT_DURATION_SEC=5
MAX_VIDEO_DURATION_SEC=35
MAX_VOICEOVER_CHARS=120
DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# --- Planning Department Config ---
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
PLANNING_LLM_MODEL=agnes-3.0-flash

# --- Production Department Config ---
PRODUCTION_IMAGE_MODEL=agnes-image-2.5-flash
PRODUCTION_VIDEO_MODEL=agnes-video-2.5-flash

# --- Unified API Key Pool (支持负载均衡与轮询降级) ---
AGNES_API_KEY=your_agnes_api_key_here
AGNES_API_KEY_1=your_agnes_api_key_1_here
AGNES_API_KEY_2=your_agnes_api_key_2_here
AGNES_API_KEY_3=your_agnes_api_key_3_here
AGNES_API_KEY_4=your_agnes_api_key_4_here
AGNES_API_KEY_5=your_agnes_api_key_5_here
AGNES_API_KEY_6=your_agnes_api_key_6_here

# --- QA & Evolution Department Config ---
QA_LLM_API_KEY=your_qa_api_key_here
QA_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
QA_LLM_MODEL=agnes-3.0-flash

# --- Market Feedback Department Config ---
MARKET_FEEDBACK_LLM_API_KEY=your_market_feedback_api_key_here
MARKET_FEEDBACK_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
MARKET_FEEDBACK_LLM_MODEL=agnes-3.0-flash

# --- Cloudflare R2 / S3 Object Storage Config ---
STORAGE_PROVIDER=r2
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your_r2_public_domain_or_subdomain

# --- Local Media Server (Optional / MinIO) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=ai-short-drama-media
PUBLIC_MEDIA_URL=http://localhost:9000/ai-short-drama-media

# --- Network & Deployment ---
BACKEND_PORT=8008
FRONTEND_PORT=5173
PROD_FRONTEND_PORT=3008
TUNNEL_TOKEN=your_optional_cloudflare_tunnel_token

# --- Security, Auth & Rate Limiting ---
JWT_SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8008
DEFAULT_RATE_LIMIT=120/minute

# --- Database Config ---
# 默认使用 SQLite（开发模式），生产环境建议配置 PostgreSQL：
# DATABASE_URL=postgresql://user:password@localhost:5432/aishortcompany
DATABASE_URL=
